#!/usr/bin/env bash
# Score the desktop perception on saved captures. Reads image files only; see perception_eval.py.
#
#   scripts/perception-eval check DIR              validate labels and coverage, reading no image
#   scripts/perception-eval run DIR [--out FILE]   score the current pipeline on DIR
#   scripts/perception-eval compare BASE NEW       what changed from one report to another
#
# `run` calls the platform's OCR on each file, which on a Mac is the desktop adapter: ask first.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run clicker-perception-eval "$@"
